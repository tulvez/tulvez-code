{
  "name": "tulvez-code",
  "displayName": "Tulvez Code",
  "description": "%description%",
  "version": "0.3.2",
  "publisher": "tulvez",
  "repository": {
    "type": "git",
    "url": "https://github.com/tulvez/tulvez-code.git"
  },
  "bugs": {
    "url": "https://github.com/tulvez/tulvez-code/issues"
  },
  "homepage": "https://github.com/tulvez/tulvez-code#readme",
  "keywords": [
    "ai",
    "copilot",
    "openai",
    "anthropic",
    "gemini",
    "code assistant",
    "chat",
    "code review"
  ],
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#181818",
    "theme": "dark"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onCommand:tulvez.openPanel",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tulvez.openPanel",
        "title": "%cmd.openPanel%"
      },
      {
        "command": "tulvez.playIntroSound",
        "title": "%cmd.playIntroSound%"
      },
      {
        "command": "tulvez.newChat",
        "title": "%cmd.newChat%",
        "category": "Tulvez Code",
        "icon": "$(add)"
      },
      {
        "command": "tulvez.exportChat",
        "title": "%cmd.exportChat%",
        "category": "Tulvez Code",
        "icon": "$(save)"
      },
      {
        "command": "tulvez.showHistory",
        "title": "%cmd.showHistory%",
        "category": "Tulvez Code",
        "icon": "$(history)"
      },
      {
        "command": "tulvez.openSettings",
        "title": "%cmd.openSettings%",
        "category": "Tulvez Code",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tulvez.newChat",
          "when": "view == tulvez.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "tulvez.exportChat",
          "when": "view == tulvez.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "tulvez.showHistory",
          "when": "view == tulvez.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "tulvez.openSettings",
          "when": "view == tulvez.sidebar",
          "group": "navigation@4"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tulvez",
          "title": "Tulvez Code",
          "icon": "resources/tulvez.svg"
        }
      ]
    },
    "views": {
      "tulvez": [
        {
          "type": "webview",
          "id": "tulvez.sidebar",
          "name": "Tulvez Code"
        }
      ]
    },
    "configuration": {
      "title": "Tulvez Code",
      "properties": {
        "tulvez.aiProvider": {
          "type": "string",
          "enum": [
            "openai",
            "gemini",
            "anthropic",
            "groq",
            "opencode",
            "opencode-go",
            "openrouter",
            "custom",
            "ollama"
          ],
          "default": "openai",
          "description": "%set.aiProvider%"
        },
        "tulvez.language": {
          "type": "string",
          "enum": [
            "auto",
            "tr",
            "en"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%set.language.auto%",
            "%set.language.tr%",
            "%set.language.en%"
          ],
          "description": "%set.language%"
        },
        "tulvez.model": {
          "type": "string",
          "default": "",
          "description": "%set.model%"
        },
        "tulvez.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "%set.ollamaUrl%"
        },
        "tulvez.baseUrl": {
          "type": "string",
          "default": "https://opencode.ai/zen/v1",
          "description": "%set.baseUrl%"
        },
        "tulvez.showModels": {
          "type": "boolean",
          "default": false,
          "description": "%set.showModels%"
        },
        "tulvez.showThinking": {
          "type": "boolean",
          "default": true,
          "description": "%set.showThinking%"
        },
        "tulvez.showAiEdits": {
          "type": "boolean",
          "default": true,
          "description": "%set.showAiEdits%"
        },
        "tulvez.sound": {
          "type": "boolean",
          "default": true,
          "description": "%set.sound%"
        },
        "tulvez.skillsRegistry": {
          "type": "string",
          "default": "https://github.com/tulvez",
          "description": "%set.skillsRegistry%"
        },
        "tulvez.gitCoAuthor": {
          "type": "boolean",
          "default": true,
          "description": "%set.gitCoAuthor%"
        },
        "tulvez.mcpServers": {
          "type": "object",
          "default": {},
          "markdownDescription": "%set.mcpServers%",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "http",
                  "sse"
                ]
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "disabled": {
                "type": "boolean"
              }
            }
          }
        },
        "tulvez.allowShellCommands": {
          "type": "boolean",
          "default": false,
          "description": "%set.allowShellCommands%"
        },
        "tulvez.autoApproveCommands": {
          "type": "boolean",
          "default": false,
          "description": "%set.autoApproveCommands%"
        },
        "tulvez.telemetry": {
          "type": "boolean",
          "default": false,
          "description": "%set.telemetry%"
        },
        "tulvez.sendCodeContext": {
          "type": "boolean",
          "default": false,
          "description": "%set.sendCodeContext%"
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "esbuild src/extension.ts --bundle --platform=node --external:vscode --format=cjs --outfile=dist/extension.js",
    "build:webview": "vite build",
    "build:cli": "node cli/build.mjs",
    "check": "tsc --noEmit && tsc -p webview/tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p cli/tsconfig.json",
    "package": "npm run build",
    "watch:extension": "esbuild src/extension.ts --bundle --platform=node --external:vscode --format=cjs --outfile=dist/extension.js --watch",
    "watch:webview": "vite build --watch",
    "watch:cli": "node cli/build.mjs --watch",
    "dev": "npm run build && \"%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\bin\\code.cmd\" --extensionDevelopmentPath=\"%CD%\" --new-window --skip-welcome",
    "test": "vitest run",
    "surum:denetle": "node scripts/surum-denetimi.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "1.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.24.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/mcp": "2.0.65",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "ai": "^7.0.127",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.50.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  }
}
