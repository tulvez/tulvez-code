{
  "name": "tulvez-code",
  "displayName": "Tulvez Code",
  "description": "VS Code için odaklı yapay zeka kodlama yardımcısı.",
  "version": "0.1.0",
  "publisher": "tulvez",
  "repository": {
    "type": "git",
    "url": "https://github.com/tulvez/tulvez-code.git"
  },
  "bugs": {
    "url": "https://github.com/tulvez/tulvez-code/issues"
  },
  "homepage": "https://github.com/tulvez/tulvez-code#readme",
  "keywords": [
    "ai",
    "copilot",
    "openai",
    "anthropic",
    "gemini",
    "code assistant",
    "chat",
    "code review"
  ],
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:tulvez.openPanel",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tulvez.openPanel",
        "title": "Tulvez Code: Paneli Aç"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tulvez",
          "title": "Tulvez Code",
          "icon": "resources/tulvez.svg"
        }
      ]
    },
    "views": {
      "tulvez": [
        {
          "type": "webview",
          "id": "tulvez.sidebar",
          "name": "Tulvez Code"
        }
      ]
    },
    "configuration": {
      "title": "Tulvez Code",
      "properties": {
        "tulvez.aiProvider": {
          "type": "string",
          "enum": [
            "openai",
            "gemini",
            "anthropic",
            "groq",
            "opencode",
            "custom",
            "ollama"
          ],
          "default": "openai",
          "description": "Kullanılacak yapay zeka sağlayıcısı."
        },
        "tulvez.model": {
          "type": "string",
          "default": "",
          "description": "Kullanılacak model adı (boşsa sağlayıcının varsayılanı)."
        },
        "tulvez.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama sunucu adresi."
        },
        "tulvez.baseUrl": {
          "type": "string",
          "default": "https://opencode.ai/zen/v1",
          "description": "OpenAI uyumlu özel sağlayıcılar için endpoint (OpenCode Zen, OpenRouter, LM Studio vb.)."
        },
        "tulvez.showModels": {
          "type": "boolean",
          "default": false,
          "description": "Model seçim listesini sohbet arayüzünde ve ayarlarda göster (varsayılan: kapalı)."
        },
        "tulvez.showThinking": {
          "type": "boolean",
          "default": true,
          "description": "Modelin düşünüş (reasoning) metnini sohbette göster."
        },
        "tulvez.showAiEdits": {
          "type": "boolean",
          "default": true,
          "description": "Tulvez Code tarafından yazılan satırları editörde işaretle."
        },
        "tulvez.allowShellCommands": {
          "type": "boolean",
          "default": false,
          "description": "Tulvez Code'un terminal komutları çalıştırmasına izin ver."
        },
        "tulvez.autoApproveCommands": {
          "type": "boolean",
          "default": false,
          "description": "Komutları onay sormadan otomatik çalıştır."
        },
        "tulvez.telemetry": {
          "type": "boolean",
          "default": false,
          "description": "Anonim kullanım verisi gönder (henüz aktif değil)."
        },
        "tulvez.sendCodeContext": {
          "type": "boolean",
          "default": false,
          "description": "AI isteklerine kod bağlamı ekle."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "esbuild src/extension.ts --bundle --platform=node --external:vscode --format=cjs --outfile=dist/extension.js",
    "build:webview": "vite build",
    "check": "tsc --noEmit && tsc -p webview/tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "package": "npm run build",
    "watch:extension": "esbuild src/extension.ts --bundle --platform=node --external:vscode --format=cjs --outfile=dist/extension.js --watch",
    "watch:webview": "vite build --watch",
    "dev": "npm run build && \"%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\bin\\code.cmd\" --extensionDevelopmentPath=\"%CD%\" --new-window --skip-welcome",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "ai": "^7.0.127",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.50.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  }
}
