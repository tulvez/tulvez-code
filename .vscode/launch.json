{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tulvez Code'u Çalıştır",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--new-window",
        "--skip-welcome"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "build",
      "internalConsoleOptions": "openOnSessionStart",
      "autoAttachChildProcesses": true
    }
  ]
}
